{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "seo_nexus",
  "version": "1.0.5",
  "description": "SEO Nexus - A modern SEO-focused website template Landing Page",
  "main": "index.js",
  "scripts": {
    "start": "node  ./compilepg.cjs",
    "watch": "nodemon -e .css --watch src/assets/css/main.css --watch src/assets/css/chatbox.css --watch compilepg.cjs --watch .env --watch ./src/views/index.pug --exec \"node ./compilepg.cjs\"",
    "lint": "npx eslint assets/css/main.css ./assets/js/main.js assets/css/color-palette/*.css",
    "lint:fix": "npx eslint assets/css/main.css assets/js/main.js assets/css/color-palette/*.css --fix",
    "deploy": "firebase deploy --only hosting"
   
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@types/jquery": "^3.5.33",
    "@types/node": "^25.1.0",
    "@types/pug": "^2.0.10",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "animate.css": "^4.1.1",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.9.0",
    "fontawesome": "^5.6.3",
    "jquery": "^4.0.0",
    "jsdom": "^28.1.0",
    "nodemon": "^3.1.11",
    "owljs": "^0.9.1",
    "pug": "^3.0.3",
    "waypoints": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.0",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "scss": "^0.2.4"
    
  }
}
