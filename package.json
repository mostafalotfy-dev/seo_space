{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "seo_space",
  "version": "2.3.0",
  "description": "SEO Space - A modern SEO-focused website template Landing Page",
  "main": "index.js",
  "scripts": {
    "start": "concurrently  \"npm run gulp\" \"npm run lint\" \"npm run deploy\" \"npm run babel\" \"npx rollup -c rollup.config.mjs\" \"npm run purgecss\" ",
    "watch:gulp": "gulp -f gulp.cjs watch ",
    "watch:rollup": "npx rollup -c rollup.config.mjs -w",
    "lint": "npx eslint ./src/assets/css/main.css ./src/assets/js/main.js",
    "lint:fix": "npx eslint ./src/assets/css/main.css ./src/assets/js/main.js  --fix",
    "deploy": "firebase deploy --only hosting",
    "gulp": "gulp -f gulp.cjs",
    "babel": "npx babel src/assets/js --config-file ./babel.config.json --out-dir public/dist --extensions .ts,.js,.tsx,.jsx,.cjs,.mjs",
    "purgecss": "gulp -f gulp.cjs purgecss"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@types/gulp-rename": "^2.0.7",
    "@types/jquery": "^3.5.33",
    "@types/node": "^25.1.0",
    "@types/pug": "^2.0.10",
    "animate.css": "^4.1.1",
    "bootstrap": "^5.3.8",
    "core-js": "^3.48.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.9.0",
    "fontawesome": "^5.6.3",
    "jquery": "^4.0.0",
    "jsdom": "^28.1.0",
    "nodemon": "^3.1.11"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.0",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/core-js": "^2.5.8",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-preprocess": "^6.0.0",
    "gulp-pug": "^5.0.0",
    "gulp-purgecss": "^8.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-sequence": "^1.0.0",
    "rollup": "^4.58.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-swc3": "^0.12.1",
    "scss": "^0.2.4"
  }
}
