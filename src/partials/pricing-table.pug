
#pricing-tables
    .section-title
        h1 #{t("price_title")}
        p #{t("price_description")}

        .container.text-center
            .pricing-table.text-left
                .row
                    each price in t("prices")

                        .col-md-6.col-lg-4
                            .single-table
                                h2 #{price.main_title} #{price.recommended} 
                                p.price
                                    span  #{price.time_in_text}
                                    span.dollar-icon  #{price.price_in_text} #{price.price_sign}
                                    
                                    
                                ul
                                    each f in price.features
                                    
                                        li #{f.feature}
                                
                            a.col-12.btn.btn-secondary(href="#") Sign-up
