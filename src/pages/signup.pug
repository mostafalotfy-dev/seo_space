extends ../layout

block head
    - const dir = (lang == "ar") ? "rtl" : "ltr";
    +headSection(lang, theme_name)
block content
    +navbar()
    +preloader()
    form#signup(action="#", method="post", class="signup-form" dir=dir , class="vh-100 d-flex align-items-center")
        .container
            .row.justify-content-center.mt-5
                .col-lg-6
                    .card
                        .card-body
                            h2.text-center #{t("signup.title")}
                            p.text-center #{t("signup.description")}
                            .mb-3
                                label.form-label(for="email") #{t("signup.email_label")}
                                input.form-control(type="email", id="email", name="email", placeholder=t("signup.email_placeholder"), required)
                            .mb-3
                                label.form-label(for="password") #{t("signup.password_label")}
                                input.form-control(type="password", id="password", name="password", placeholder=t("signup.password_placeholder"), required)
                            button.btn.btn-primary.w-100(type="submit") #{t("signup.button_text")}
block footer
    +footer()

block scripts
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous")
  script(src="https://cdn.jsdelivr.net/npm/dompurify@3.3.1/dist/purify.min.js")
  script(src="https://unpkg.com/@wcj/markdown-to-html/dist/markdown.min.js")
  //- script(src="./assets/js/animation.js")
  script(src="./dist/bundle.js" defer )
  noscript
    | Enable Javascript