extends ../layout
block head
    - const dir = (lang == "ar") ? "rtl" : "ltr";
    +headSection(lang, theme_name)
block content
    +navbar(lang)
    +preloader()
    form#login(action="#", method="post", class="login-form justify-content-center vh-100 d-flex align-items-center" dir=dir)
        .container
            .row.justify-content-center
                .col-lg-6
                    .card
                        .card-body
                            h2.text-center #{t("login.title")}
                            p.text-center #{t("login.description")}
                            .mb-3
                                label.form-label(for="email") #{t("login.email_label")}
                                input.form-control(type="email", id="email", name="email", placeholder=t("login.email_placeholder"), required)
                            .mb-3
                                label.form-label(for="password") #{t("login.password_label")}
                                input.form-control(type="password", id="password", name="password", placeholder=t("login.password_placeholder"), required)
                            button.btn.btn-primary.w-100(type="submit") #{t("login.button_text")}

    +footer()
block scripts
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous")
  script(src="https://cdn.jsdelivr.net/npm/dompurify@3.3.1/dist/purify.min.js")
  script(src="https://unpkg.com/@wcj/markdown-to-html/dist/markdown.min.js")
  //- script(src="./assets/js/animation.js")
  script(src="./dist/bundle.js" defer )
  noscript
    | Enable Javascript