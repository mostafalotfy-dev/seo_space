//- ================================================
//- CONTACT MIXIN: Contact Form and Information Section
//- ================================================
//- Displays contact form and company contact information
//- Features:
//-   - Two-column layout: contact info on left, form on right
//-   - Contact form with name, surname, email, and message fields
//-   - Phone information with clickable link
//-   - Animated entrance effects (fadeInLeft, fadeInRight)
//-   - Responsive form fields
//-   - Decorative image element
//-   - Language support (LTR/RTL text direction)
//- Parameters:
//-   - lang: Current language for directional styling
//- Form Fields:
//-   - Name (required)
//-   - Surname (required)
//-   - Email (required, with pattern validation)
//-   - Message (required, textarea)
//- Form Action: action="" should be updated to actual backend endpoint
//- Dependencies: Bootstrap 5.3+, WOW.js animations, Font Awesome icons

mixin contact(lang)
  #contact.contact-us.section
    .container
      .row
        //- ================================================
        //- LEFT COLUMN: Contact Information
        //- ================================================
        //- Company contact details and heading
        .col-lg-6.align-self-center.wow.fadeInLeft
          .section-heading.py-3
            //- Section heading
            h2 #{t("contact.heading")}
            //- Section description
            p #{t("contact.description")}
            
            //- ================================================
            //- PHONE INFORMATION WITH ICON
            //- ================================================
            .phone-info
              h4 #{t("contact.phone_text")}
                span
                  //- Phone icon from Font Awesome
                  i.fa.fa-phone
                  //- Clickable phone number link (update href with actual number)
                  a(href="#") 010-020-0340
        
        //- ================================================
        //- RIGHT COLUMN: Contact Form
        //- ================================================
        //- User-submitted contact form
        .col-lg-6.wow.fadeInRight(data-wow-duration="0.5s", data-wow-delay="0.25s")
          form#contact(action="", method="post" dir=dir)
            .row
              //- Name field
              .col-lg-6
                fieldset
                  input#name(
                    type="text",
                    name="name",
                    placeholder=t("contact.form.name"),
                    autocomplete="on",
                    required
                  )
              
              //- Surname field
              .col-lg-6
                fieldset
                  input#surname(
                    type="text",
                    name="surname",
                    placeholder=t("contact.form.surename"),
                    autocomplete="on",
                    required
                  )
              
              //- Email field with pattern validation
              .col-lg-12
                fieldset
                  input#email(
                    type="text",
                    name="email",
                    pattern="[^ @]*@[^ @]*",
                    placeholder=t("contact.form.email"),
                    required
                  )
              
              //- Message textarea
              .col-lg-12
                fieldset
                  textarea#message.form-control(
                    name="message",
                    type="text",
                    placeholder=t("contact.form.message"),
                    required
                  )
              
              //- Submit button
              .col-lg-12
                fieldset
                  button#form-submit.main-button(type="submit")
                    | #{(t("contact.form.submit"))}
            
            //- ================================================
            //- DECORATIVE ELEMENT: Language-Specific Flip
            //- ================================================
            //- Decorative image element that flips based on language direction
            //- Used for visual balance on right-aligned RTL content
            - let flip_class= (lang == "ar") ? "ar" : "en";
            .contact-dec(class="flip " + flip_class)
              img(src="./assets/images/contact-decoration.png", loading="lazy", alt="")