//- ================================================
//- ABOUT MIXIN: About Us / Company Information Section
//- ================================================
//- Displays company information and service offerings in a grid
//- Features:
//-   - Left side: company image (desktop only, hidden on mobile)
//-   - Right side: about heading and service/capability cards
//-   - 2x2 grid of service cards with icons
//-   - Animated entrance effects (fadeIn with staggered delays)
//-   - Responsive layout: image hidden on mobile (flex utilities)
//-   - Company logo/image and service icons with descriptions
//- Parameters:
//-   - lang: Current language for translated content
//- Service Categories:
//-   - Data Analysis
//-   - Data Reporting
//-   - Web Analytics
//-   - SEO Suggestions
//- NOTE: Lorem ipsum placeholder text - replace with actual company information

mixin about(lang)
  #about.about-us.section
    .container
      .row
        //- Section heading: centered across full width with margin
        h2.my-5 #{t("menu.about")}
        
        //- ================================================
        //- LEFT COLUMN: Company Image
        //- ================================================
        //- Decorative company/team image
        //- Hidden on all devices except large screens (d-none d-lg-block)
        //- Animated with fadeIn effect
        .col-lg-4
          .left-image.d-md-none.d-none.d-sm-none.d-lg-block.d-xxl-block.d-xl-block.wow.fadeIn(data-wow-duration="1s", data-wow-delay="0.2s")
            img(src="./assets/images/about-left-image.png", loading="lazy" alt=t("about.alt.person_graphic"))
        
        //- ================================================
        //- RIGHT COLUMN: Services/Capabilities Grid
        //- ================================================
        //- Four service cards in 2x2 grid with icons and descriptions
        .col-lg-8
          .services
            .row
              //- SERVICE 1: Data Analysis (top-left)
              .col-lg-6
                .item.wow.fadeIn(data-wow-duration="1s", data-wow-delay="0.5s")
                  //- Service icon
                  .icon
                    img(src="./assets/images/service-icon-01.png", loading="lazy", alt=t("banner.alt.reporting"))
                  //- Service name and description
                  .right-text
                    h4 #{t("about.services.data_analysis")}
                    p #{t("about.services.description")}
              
              //- SERVICE 2: Data Reporting (top-right)
              .col-lg-6
                .item.wow.fadeIn(data-wow-duration="1s", data-wow-delay="0.7s")
                  .icon
                    img(src="./assets/images/service-icon-02.png", loading="lazy", alt="")
                  .right-text
                    h4 #{t("about.services.data_reporting")}
                    p #{t("about.services.description")}
              
              //- SERVICE 3: Web Analytics (bottom-left)
              .col-lg-6
                .item.wow.fadeIn(data-wow-duration="1s", data-wow-delay="0.9s")
                  .icon
                    img(src="./assets/images/service-icon-03.png", loading="lazy", alt="")
                  .right-text
                    h4 #{t("about.services.web_analytics")}
                    p #{t("about.services.description")}
              
              //- SERVICE 4: SEO Suggestions (bottom-right)
              .col-lg-6
                .item.wow.fadeIn(data-wow-duration="1s", data-wow-delay="1.1s")
                  .icon
                    img(src="./assets/images/service-icon-04.png", loading="lazy", alt="")
                  .right-text
                    h4 #{t("about.services.seo_suggestions")}
                    p #{t("about.services.description")}