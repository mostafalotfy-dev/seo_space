mixin header(lang)
   header.header-area.header-sticky.wow.slideInDown(data-wow-duration="0.75s", data-wow-delay="0s")
      .container
        .row
          .col-12
            nav.main-nav
              // ***** Logo Start *****
              a.logo(href="output-ar-theme-loyal-green-dark.html")
                h4.h6 #{t("header.logo.part1")}
                  span #{t("header.logo.part2")}
              // ***** Logo End *****
              // ***** Menu Start *****
              ul.nav
                li.scroll-to-section
                  a.active(href="#top") #{t("menu.home")}
                li.scroll-to-section
                  a(href="#about") #{t("menu.about")}
                li.scroll-to-section
                  a(href="#services") #{t("menu.services")}
                li.scroll-to-section
                  a(href="#portfolio") #{t("menu.portfolio")}
                li.scroll-to-section
                  a(href="#blog") #{t("menu.blog")}
                li.scroll-to-section
                  a(href="#contact") #{t("menu.message_us")}
                li.scroll-to-section
                  button.btn.btn-sm.btn-primary-subtle(type="button" id="theme-toggle" )
                    i.fa.fa-moon-o
                li
                  .dropdown
                    a(href="#" data-bs-toggle="dropdown" aria-expanded="false") #{t("menu.language")}
                    ul.dropdown-menu
                      li
                        a.dropdown-item(href=full_theme_name) English
                      li
                        a.dropdown-item(href=full_theme_name.replace("en","ar")) العربية
                
              a.menu-trigger
                span #{t("menu.trigger")}