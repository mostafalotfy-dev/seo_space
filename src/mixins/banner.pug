mixin banner(lang)
  #top.main-banner.wow.fadeIn(data-wow-duration="1s", data-wow-delay="0.5s")
      .container
        .row
          .col-lg-12
            .row
              .col-lg-6.align-self-center
                .left-content.header-text.wow.fadeInLeft(data-wow-duration="1s", data-wow-delay="1s")
                  h6 #{t("banner.welcome")} 
                  h2 #{t("banner.we_make")}  
                    em #{t("banner.digital_ideas")}
                    | & 
                    span #{t("banner.seo")}
                    | #{t("banner.marketing")}
                  p 
                    bdi #{t("banner.description.part1")}
                    a(rel="nofollow", href="https://example.com/page/1", target="_parent") 
                    | #{t("banner.description.part2")}
                  form#search(action="#", method="post")
                    fieldset
                      input.email(type="url", name="address", placeholder=t("banner.placeholder.website_url"),dir=dir, autocomplete="on", required)
                    fieldset
                      button.main-button(type="submit",dir=dir) #{t("banner.button.analyze")}
              .col-lg-6
                .right-image.wow.text-start.text-sm-center.fadeInRight(data-wow-duration="1s", data-wow-delay="0.5s")
                  img(src="./assets/images/banner-right-image.png", alt=t("banner.alt.team_meeting"))