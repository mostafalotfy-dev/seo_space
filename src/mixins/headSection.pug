mixin headSection(lang, theme_name)
  
  meta(charset="UTF-8")
  meta(name="viewport", content="width=device-width, initial-scale=1, shrink-to-fit=no")
  meta(name="description", content="")
  meta(name="author", content="Mostafa Lotfy")
  link(rel="preconnect", href="https://fonts.googleapis.com")
  link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
  link(href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap", rel="stylesheet")

  title #{t("title.main")}
  // Bootstrap core CSS
  
  link(rel="icon", href="./assets/images/favicon.ico" type="image/x-icon")
  link(rel="favicon", href="./assets/images/favicon.ico" type="image/x-icon")
  link(rel="apple-touch-icon" href="./assets/images/favicon.ico" sizes="16x16")
  // Additional CSS Files

  link(rel="stylesheet", href="./dist/css/color-palette/"+ theme_name)
  link(rel="stylesheet", href="./dist/css/app.css" defer)
  
  link(rel="stylesheet" href="https://unpkg.com/@wcj/markdown-to-html/dist/marked.css" defer)
  //- link(rel="stylesheet", href="./assets/css/animated.css")
  //- link(rel="stylesheet", href="./assets/css/owl.css")