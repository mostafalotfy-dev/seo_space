extends layout

block head
    - const dir = (lang == "ar") ? "rtl" : "ltr";
    +headSection(lang, theme_name)
  
block content
    // ***** Header Area Start *****
    +header(lang)
    // ***** Header Area End *****
    +banner(lang)
    // ***** Header Area Start *****
    // ***** Preloader Start *****
    +preloader()
    // ***** Preloader End *****
    // ***** Services Area Start *****
    +services(lang)
    // ***** Services Area End *****
    // ***** Portfolio Area End *****
    +portfolio(lang)
    // ***** Portfolio Area End *****
    // ***** About Area Start *****
    +about(lang)
    // ***** About Area End *****
    // ***** Blog Area Start *****
    +blog(lang)
    // ***** Blog Area End *****
    // ***** Contact Area Start *****
    +contact(lang)
    // ***** Contact Area End *****
    // ***** Assistant Area Start *****
    +assistant(lang)
    // ***** Assistant Area End *****
    // Newsletter Start Area
    +defaultModal("newsletter",t("newsletter"))
        include partials/newsletter
    // Newsletter End Area
    // ***** Footer Area Start *****
block footer
    +footer()
    // ***** Footer Area End *****
    
   
//- Scripts
block scripts
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js")
  script(src="https://cdn.jsdelivr.net/npm/dompurify@3.3.1/dist/purify.min.js")
  
  script(src="https://unpkg.com/@wcj/markdown-to-html/dist/markdown.min.js")
  //- script(src="./assets/js/animation.js")
  script(src="./dist/bundle.js" defer )
  noscript
    | Enable Javascript

    
    
    
    
        
          
    
    

      
