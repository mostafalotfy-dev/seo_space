extends layout

block head
  head
    +headSection(lang, theme_name)
    - const dir = (lang == "ar") ? "rtl" : "ltr"
 
    block content
      // ***** Header Area Start *****
      +header(lang)
      // ***** Header Area End *****
      //- // ***** Preloader Start *****
      //- +preloader()
      //- // ***** Preloader End *****
      // ***** Banner Area Start *****
      +banner(lang)
      // ***** Banner Area End *****
      // ***** Services Area Start *****
      +services(lang)
      // ***** Services Area End *****
      // ***** Contact Area Start *****
      +contact(lang)
      // ***** Contact Area End *****
      // ***** Footer Area Start *****
      +footer()
      // ***** Footer Area End *****
      // ***** Assistant Area Start *****
      +assistant(lang)
      // ***** Assistant Area End *****
      //- Scripts
      
      script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous")
      script(src="https://cdn.jsdelivr.net/npm/dompurify@3.3.1/dist/purify.min.js")
      
      script(src="https://unpkg.com/@wcj/markdown-to-html/dist/markdown.min.js")
      //- script(src="./assets/js/animation.js")
      script(src="./dist/bundle.js" defer )
      noscript
        | Enable Javascript

      
      
      
      
          
           
    
    

      
